    "/api/orders": {
      "get": {
        "summary": "Authenticated account order history (200)",
        "parameters": [
          {
            "name": "instrument",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON domain document"
          },
          "401": {
            "description": "Authentication required"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      },
      "post": {
        "summary": "Submit idempotent orders command",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "client_id",
                  "instrument",
                  "side",
                  "type",
                  "tif",
                  "quantity"
                ],
                "properties": {
                  "client_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "instrument": {
                    "type": "string",
                    "enum": [
                      "BTC-USD",
                      "ETH-USD",
                      "SOL-USD"
                    ]
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "BUY",
                      "SELL"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "LIMIT",
                      "MARKET"
                    ]
                  },
                  "tif": {
                    "type": "string",
                    "enum": [
                      "GTC",
                      "IOC"
                    ]
                  },
                  "price": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "quantity": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "max_spend": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed command envelope (schema_version=1)"
          },
          "400": {
            "description": "Malformed request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unknown instrument"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "422": {
            "description": "Durably recorded business rejection"
          },
          "429": {
            "description": "Rate limit or queue saturation"
          },
          "503": {
            "description": "Engine unsafe, dependency failure or ambiguous commit; retry same key"
          },
          "504": {
            "description": "Deadline; retry same key"
          }
        }
      }
    },
